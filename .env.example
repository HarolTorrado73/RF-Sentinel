# Copiar a .env y ajustar valores antes de producción:
#   cp .env.example .env
#
# Luego: docker compose up --build -d
APP_ENV=development
SECRET_KEY=change-me-in-production-use-secrets-token-urlsafe
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

POSTGRES_USER=sentinelrecon
POSTGRES_PASSWORD=sentinelrecon
POSTGRES_DB=sentinelrecon

REDIS_DB=0

API_PORT=8000
FRONTEND_PORT=3000
# Vacío = el frontend llama a /api vía nginx. Opcional: http://localhost:8000
VITE_API_URL=

STORAGE_PATH=storage
REPORTS_DIR=storage/reports
LOGS_DIR=logs

# Semillas iniciales (solo se crean si no existen)
SEED_ADMIN_EMAIL=admin@rf-sentinel.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=adminchangeme
SEED_ADMIN_FULL_NAME=RF Sentinel Admin
