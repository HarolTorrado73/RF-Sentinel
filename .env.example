# Copiar a .env y ajustar valores antes de producción:
#   cp .env.example .env
#
# Luego: docker compose up --build -d
APP_ENV=development
SECRET_KEY=change-me-in-production-use-secrets-token-urlsafe
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

POSTGRES_USER=sentinelrecon
POSTGRES_PASSWORD=sentinelrecon
POSTGRES_DB=sentinelrecon

REDIS_DB=0

API_PORT=8000
FRONTEND_PORT=3000
# URL que usa el navegador para llamar a la API (no el hostname Docker interno).
VITE_API_URL=http://localhost:8000
